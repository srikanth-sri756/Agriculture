# --- Database (Neon Postgres) ---
# Get this from https://console.neon.tech → your project → Connection string
# Use the "pooled" URL for serverless (Netlify) — has -pooler in the host
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# (Optional) Direct (non-pooled) URL — only needed if you want `prisma migrate`
# from CI to bypass the pooler. Locally you can omit this.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Set to your deployed URL in production (e.g. https://yoursite.netlify.app)
# Leave blank for local dev.
NEXTAUTH_URL="http://localhost:3000"

# --- Firebase (OTP — optional, fill if you use Firebase Auth phone OTP) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
